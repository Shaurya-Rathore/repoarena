{
	"name": "repoarena",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@9.15.0",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=9"
	},
	"scripts": {
		"build": "pnpm -r --if-present build",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"typecheck": "pnpm build && pnpm -r --if-present typecheck",
		"test": "pnpm test:unit",
		"test:unit": "pnpm -r --if-present test:unit",
		"test:integration": "pnpm -r --workspace-concurrency=1 --if-present test:integration",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build",
		"release:verify": "node scripts/release-verify.mjs",
		"release:dry-run": "node scripts/release-dry-run.mjs",
		"release:packed-cli": "node scripts/packed-cli-e2e.mjs",
		"demo": "pnpm --filter repoarena build && node scripts/oss-demo.mjs",
		"docs:check": "node scripts/check-doc-links.mjs",
		"release:backup-restore": "node scripts/backup-restore-e2e.mjs",
		"release:security": "node scripts/release-security.mjs",
		"release:secret-scan": "secretlint '**/*' --secretlintignore .gitignore",
		"config:validate:production": "node scripts/validate-production-config.mjs",
		"release:licenses": "node scripts/license-audit.mjs",
		"release:clean-checkout": "node scripts/clean-checkout-e2e.mjs",
		"release:performance": "node scripts/release-performance.mjs",
		"release:publish:check": "node scripts/release-publish-check.mjs",
		"dev:infra": "docker compose -f infra/compose/docker-compose.dev.yml up -d",
		"dev:infra:down": "docker compose -f infra/compose/docker-compose.dev.yml down",
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:seed": "node scripts/db-seed.mjs",
		"cloud:api": "node scripts/cloud-api.mjs",
		"cloud:product": "node scripts/cloud-product.mjs",
		"test:cloud-product-built": "pnpm --filter @repoarena/cloud-product build && node scripts/cloud-product-built-e2e.mjs",
		"cloud:scheduler": "node scripts/cloud-scheduler.mjs",
		"cloud:jobs": "node scripts/cloud-jobs.mjs",
		"cloud:github-webhooks": "node scripts/github-webhooks.mjs",
		"billing:reconcile": "node scripts/billing-reconcile.mjs",
		"billing:webhooks": "node scripts/billing-webhooks.mjs",
		"billing:stripe-smoke": "node scripts/stripe-smoke.mjs",
		"hosted:reconcile": "node scripts/hosted-reconcile.mjs",
		"hosted:control": "node scripts/hosted-control.mjs",
		"hosted:provider-smoke": "node scripts/hosted-compute-smoke.mjs",
		"github:smoke": "node scripts/github-smoke.mjs",
		"s3:smoke": "node scripts/s3-smoke.mjs",
		"agent:smoke": "node scripts/agent-smoke.mjs",
		"test:postgres": "pnpm --filter @repoarena/cloud-db test:integration",
		"skills:validate": "node scripts/validate-skills.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@secretlint/secretlint-rule-preset-recommend": "10.2.2",
		"@types/node": "24.10.1",
		"esbuild": "0.25.9",
		"secretlint": "10.2.2",
		"typescript": "5.7.2",
		"vitest": "2.1.8"
	}
}
