{
	"name": "repoarena",
	"version": "1.0.0",
	"private": false,
	"type": "module",
	"bin": {
		"repoarena": "./dist/index.cjs"
	},
	"exports": "./dist/index.cjs",
	"files": ["dist/index.cjs", "README.md"],
	"engines": {
		"node": ">=24 <25"
	},
	"license": "Apache-2.0",
	"scripts": {
		"build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:unit": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@repoarena/adapter-claude-code": "workspace:*",
		"@repoarena/adapter-codex": "workspace:*",
		"@repoarena/adapter-gemini-cli": "workspace:*",
		"@repoarena/adapter-opencode": "workspace:*",
		"@repoarena/adapter-sdk": "workspace:*",
		"@repoarena/benchmark-engine": "workspace:*",
		"@repoarena/config": "workspace:*",
		"@repoarena/core": "workspace:*",
		"@repoarena/git": "workspace:*",
		"@repoarena/local-product": "workspace:*",
		"@repoarena/optimizer": "workspace:*",
		"@repoarena/readiness": "workspace:*",
		"@repoarena/reporter": "workspace:*",
		"@repoarena/run-store": "workspace:*",
		"@repoarena/runner-core": "workspace:*",
		"@repoarena/sandbox-docker": "workspace:*",
		"@repoarena/sandbox-local": "workspace:*",
		"@repoarena/task-discovery": "workspace:*",
		"@repoarena/task-reconstruction": "workspace:*",
		"@repoarena/task-spec": "workspace:*",
		"@repoarena/task-validation": "workspace:*",
		"commander": "12.1.0",
		"yaml": "2.8.3"
	}
}
