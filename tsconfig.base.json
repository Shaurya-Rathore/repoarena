{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ESNext"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"useUnknownInCatchVariables": true,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true
	}
}
